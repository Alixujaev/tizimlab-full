# TizimLab backend muhit o'zgaruvchilari (config/env.ts bilan 1:1).
# Nusxa oling: backend/.env (u .gitignore'da — hech qachon commit qilinmaydi).
# Haqiqiy sirlarni bu faylga YOZMANG.
# Tasodifiy sir yaratish:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# --- Umumiy ---
# development | production | test  (Swagger, rate-limit, Telegram rejimi shunga bog'liq)
NODE_ENV=development
PORT=4000

# --- Ma'lumotlar bazasi (cloud: Neon/Railway/Supabase yoki lokal PostgreSQL) ---
# Cloud uchun SSL: URL oxiriga ?sslmode=require qo'shing (D-25)
DATABASE_URL=postgres://user:password@localhost:5432/tizimlab

# --- JWT (access 30 daqiqa, refresh 7 kun) — har biri kamida 32 belgi (D-25) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token muddatlari (spec §15 qiymatlari; o'zgaruvchi nomlari spec'da yo'q, biz qo'shdik)
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=7

# --- Sessiya ---
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- Cloudflare R2 (S3-mos) — production'da hammasi majburiy (D-25) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Telegram (bot: @BotFather) ---
# Token berilsa USERNAME majburiy; production'da WEBHOOK_URL + WEBHOOK_SECRET ham (D-26).
# Development'da polling avtomatik.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Qo'shimcha (spec'da yo'q, biz qo'shdik — D-26) ---
# Integration testlar uchun alohida baza; bo'lmasa DB testlari lokal'da o'tkazib yuboriladi (CI'da majburiy)
TEST_DATABASE_URL=
# CORS va refresh-cookie uchun frontend manzili; production'da majburiy
FRONTEND_URL=http://localhost:5173
# Reverse proxy (nginx, Railway, Render...) ortida bo'lsa true — rate-limit to'g'ri IP ni ko'rishi uchun
TRUST_PROXY=false
# Swagger UI (/docs, faqat development) HTTP Basic login — spec'da yo'q, biz qo'shdik (D-93).
# Ikkalasi bo'sh bo'lsa /docs o'chiq; birini bersangiz ikkinchisi ham majburiy.
SWAGGER_USER=
SWAGGER_PASSWORD=

# TizimLab backend muhit o'zgaruvchilari.
# Nusxa oling: backend/.env (u .gitignore'da — hech qachon commit qilinmaydi).
# Haqiqiy sirlarni bu faylga YOZMANG.

# --- Umumiy ---
# development | production | test  (Swagger, rate-limit, Telegram rejimi shunga bog'liq)
NODE_ENV=development
PORT=4000

# --- Ma'lumotlar bazasi (cloud: Neon/Railway/Supabase yoki lokal PostgreSQL) ---
DATABASE_URL=postgres://user:password@localhost:5432/tizimlab

# --- JWT (access 30 daqiqa, refresh 7 kun) ---
# Aniq nomlar spec'da berilmagan — OPEN_QUESTIONS Q-62.
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# --- Sessiya ---
SESSION_IDLE_TIMEOUT_MINUTES=30

# --- Cloudflare R2 (S3-mos) ---
# Spec faqat "R2_*" deydi; aniq nomlar — OPEN_QUESTIONS Q-62.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Telegram (bot: @BotFather) ---
# Development'da polling avtomatik; production'da WEBHOOK_URL + WEBHOOK_SECRET kerak.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# --- Qo'shimcha (spec'da yo'q, biz qo'shdik) ---
# Integration testlar uchun alohida baza (spec'da yo'q, biz qo'shdik)
TEST_DATABASE_URL=postgres://user:password@localhost:5432/tizimlab_test
# CORS va refresh-cookie uchun frontend manzili (spec'da yo'q, biz qo'shdik)
FRONTEND_URL=http://localhost:5173

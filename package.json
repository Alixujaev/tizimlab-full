{
  "name": "tizimlab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TizimLab (LabControl) — farmatsevtika LIMS, multi-tenant SaaS",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm:dev -w backend\" \"npm:dev -w frontend\"",
    "build": "npm run build --workspaces",
    "start": "npm run start -w backend",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "check": "npm run lint && npm run typecheck && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checklist:stats": "node scripts/checklist-stats.mjs",
    "etl": "tsx scripts/etl/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
